{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://village-management.com/schemas/permits/construction",
  "title": "Construction Permit Application",
  "description": "Form schema for new construction permit applications",
  "type": "object",
  "properties": {
    "projectInfo": {
      "type": "object",
      "title": "Project Information",
      "x-order": 1,
      "properties": {
        "projectStartDate": {
          "type": "string",
          "format": "date",
          "title": "Project Start Date",
          "description": "When construction will begin",
          "x-fieldType": "date",
          "x-order": 1
        },
        "projectEndDate": {
          "type": "string",
          "format": "date",
          "title": "Project End Date",
          "description": "Estimated completion date",
          "x-fieldType": "date",
          "x-order": 2
        },
        "projectDescription": {
          "type": "string",
          "title": "Project Description",
          "description": "Detailed description of construction project",
          "minLength": 10,
          "maxLength": 500,
          "x-fieldType": "textarea",
          "x-placeholder": "Describe your construction project...",
          "x-helperText": "Maximum 500 characters",
          "x-order": 3
        }
      },
      "required": ["projectStartDate", "projectEndDate", "projectDescription"]
    },
    "contractorInfo": {
      "type": "object",
      "title": "Contractor Information",
      "x-order": 2,
      "properties": {
        "contractorName": {
          "type": "string",
          "title": "Contractor Name",
          "minLength": 2,
          "maxLength": 100,
          "x-fieldType": "text",
          "x-placeholder": "Full name of contractor",
          "x-order": 1
        },
        "contractorContactNumber": {
          "type": "string",
          "title": "Contractor Contact Number",
          "pattern": "^(\\+63|0)?9\\d{9}$",
          "x-fieldType": "tel",
          "x-placeholder": "09XXXXXXXXX",
          "x-helperText": "Philippine mobile number format",
          "x-order": 2
        },
        "contractorBusinessAddress": {
          "type": "string",
          "title": "Contractor Business Address",
          "minLength": 10,
          "maxLength": 200,
          "x-fieldType": "textarea",
          "x-placeholder": "Complete business address",
          "x-order": 3
        }
      },
      "required": [
        "contractorName",
        "contractorContactNumber",
        "contractorBusinessAddress"
      ]
    }
  },
  "required": ["projectInfo", "contractorInfo"],
  "additionalProperties": false
}
